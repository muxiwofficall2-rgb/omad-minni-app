function Counter({
  label,
  value,
  onChange,
  testId,
}: {
  label: string;
  value: number;
  onChange: (n: number) => void;
  testId: string;
}) {
  return (
    <div className="counter-row">
      <span>{label}</span>

      <div className="counter">
        <button
          type="button"
          onClick={() => onChange(Math.max(0, value - 1))}
          data-testid={`${testId}-minus`}
        >
          <Minus size={15} />
        </button>

        <b data-testid={`${testId}-value`}>{value}</b>

        <button
          type="button"
          onClick={() => onChange(value + 1)}
          data-testid={`${testId}-plus`}
        >
          <Plus size={15} />
        </button>
      </div>
    </div>
  );
}

function Tickets({ language }: { language: Language }) {
  const [step, setStep] = useState(1);

  const [form, setForm] = useState({
    origin: 'Санкт-Петербург',
    destination: '',
    date: '',
    child: false,
    infants: 0,
    children: 0,
    phone: '',
  });

  const [, setLocation] = useLocation();

  const [requests, setRequests] = useLocalStorage<RequestItem[]>(
    'omad-requests',
    [],
  );

  const update = (field: string, value: string | boolean) =>
    setForm((f) => ({ ...f, [field]: value }));

  const requestText = `Запрос на авиабилет: ${form.origin} → ${
    form.destination
  }, ${form.date || 'дата уточняется'}. ${
    form.child
      ? `Младенцы: ${form.infants}, дети: ${form.children}.`
      : 'Только взрослые.'
  } Телефон: ${form.phone || 'уточнить'}.`;

  const telegramRequestLink = `${
    DESTINATIONS.telegram
  }?text=${encodeURIComponent(requestText)}`;

  const whatsappRequestLink = `${
    DESTINATIONS.whatsapp
  }?text=${encodeURIComponent(requestText)}`;

  const submit = () => {
    setRequests([
      {
        id: `ticket-${Date.now()}`,
        type: 'Air ticket',
        title: `${form.origin} → ${form.destination}`,
        status: 'New',
        detail: requestText,
        created: new Date().toISOString(),
      },
      ...requests,
    ]);

    setStep(4);
  };

  return (
    <div>
      <SectionHeading
        eyebrow={`01 / 03 · ${tr(language, 'tickets')}`}
        title={
          language === 'ru'
            ? 'Подберём ваш билет'
            : 'Let’s find your route'
        }
        detail={
          language === 'ru'
            ? 'Три коротких шага — и запрос у специалиста.'
            : 'Three short steps, then your request is ready.'
        }
        back
      />

      {step < 4 && (
        <div className="stepper">
          <span className="active">01</span>
          <i />
          <span className={step > 1 ? 'active' : ''}>02</span>
          <i />
          <span className={step > 2 ? 'active' : ''}>03</span>
        </div>
      )}

      <div className="form-card">
        {step === 1 && (
          <div className="space-y-5 rise-in">
            <div>
              <label className="field-label">Откуда</label>

              <div className="input-wrap">
                <Plane size={17} />
                <input
                  value={form.origin}
                  onChange={(e) => update('origin', e.target.value)}
                  placeholder="Город отправления"
                  data-testid="input-ticket-origin"
                />
              </div>
            </div>

            <div>
              <label className="field-label">Куда</label>

              <div className="input-wrap">
                <MapPin size={17} />
                <input
                  value={form.destination}
                  onChange={(e) =>
                    update('destination', e.target.value)
                  }
                  placeholder="Город назначения"
                  data-testid="input-ticket-destination"
                />
              </div>
            </div>

            <button
              type="button"
              onClick={() => form.destination && setStep(2)}
              className="primary-button w-full justify-center disabled:opacity-40"
              disabled={!form.destination}
              data-testid="button-ticket-step-1"
            >
              {tr(language, 'next')}
              <ArrowRight size={16} />
            </button>
          </div>
        )}

        {step === 2 && (
          <div className="space-y-5 rise-in">
            <div>
              <label className="field-label">Дата вылета</label>

              <div className="input-wrap">
                <CalendarDays size={17} />
                <input
                  type="date"
                  value={form.date}
                  onChange={(e) => update('date', e.target.value)}
                  data-testid="input-ticket-date"
                />
              </div>
            </div>

            <div className="choice-question">
              <div>
                <strong>Путешествует ребёнок?</strong>
                <small>Младенец 0–2 и ребёнок 2–12 лет</small>
              </div>

              <button
                type="button"
                className={`toggle ${form.child ? 'on' : ''}`}
                onClick={() => update('child', !form.child)}
                data-testid="button-toggle-child"
              >
                <span />
              </button>
            </div>

            {form.child && (
              <div className="space-y-1 border-t pt-3">
                <Counter
                  label="Младенцы 0–2 года"
                  value={form.infants}
                  onChange={(n) =>
                    setForm((f) => ({ ...f, infants: n }))
                  }
                  testId="counter-infant"
                />

                <Counter
                  label="Дети 2–12 лет"
                  value={form.children}
                  onChange={(n) =>
                    setForm((f) => ({ ...f, children: n }))
                  }
                  testId="counter-child"
                />
              </div>
            )}

            <div className="flex gap-2">
              <button
                type="button"
                className="secondary-button flex-1"
                onClick={() => setStep(1)}
                data-testid="button-ticket-back-2"
              >
                {tr(language, 'back')}
              </button>

              <button
                type="button"
                className="primary-button flex-[2] justify-center"
                onClick={() => setStep(3)}
                data-testid="button-ticket-step-2"
              >
                {tr(language, 'next')}
                <ArrowRight size={16} />
              </button>
            </div>
          </div>
        )}

        {step === 3 && (
          <div className="space-y-5 rise-in">
            <div>
              <label className="field-label">
                Куда отправить готовый запрос?
              </label>

              <div className="input-wrap">
                <Phone size={17} />
                <input
                  value={form.phone}
                  onChange={(e) => update('phone', e.target.value)}
                  placeholder="+7 900 000 00 00"
                  data-testid="input-ticket-phone"
                />
              </div>
            </div>

            <div className="request-preview">
              <div className="preview-label">
                <FileText size={15} />
                Текст запроса
              </div>

              <p>{requestText}</p>
            </div>

            <div className="flex gap-2">
              <button
                type="button"
                className="secondary-button flex-1"
                onClick={() => setStep(2)}
                data-testid="button-ticket-back-3"
              >
                {tr(language, 'back')}
              </button>

              <button
                type="button"
                className="primary-button flex-[2] justify-center"
                onClick={submit}
                data-testid="button-ticket-submit"
              >
                {tr(language, 'send')}
                <Send size={16} />
              </button>
            </div>
          </div>
        )}

        {step === 4 && (
          <div className="py-5 text-center rise-in">
            <div className="success-mark">
              <Check size={26} />
            </div>

            <h2 className="section-title mt-4">Запрос tayyor</h2>

            <p className="page-detail mx-auto">
              Matn tayyorlandi. Telegram yoki WhatsApp tugmasini bossangiz,
              yuborishga tayyor holda ochiladi.
            </p>

            <div className="mt-6 grid gap-2">
              <a
                href={telegramRequestLink}
                target="_blank"
                rel="noreferrer"
                className="primary-button justify-center"
                data-testid="link-ticket-telegram"
              >
                <Send size={17} />
                Telegram orqali yuborish
              </a>

              <a
                href={whatsappRequestLink}
                target="_blank"
                rel="noreferrer"
                className="secondary-button justify-center"
                data-testid="link-ticket-whatsapp"
              >
                <MessageCircle size={17} />
                WhatsApp orqali yuborish
              </a>

              <button
                type="button"
                className="secondary-button justify-center"
                onClick={() => setLocation('/requests')}
                data-testid="button-ticket-requests"
              >
                Смотреть заявки
                <ChevronRight size={16} />
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

function Visa({ language }: { language: Language }) {
  const [location, setLocation] = useLocation();

  return (
    <div>
      <SectionHeading
        eyebrow="02 / VISA DESK"
        title={
          language === 'ru'
            ? 'Виза — без лишних шагов'
            : 'Visa, made clearer'
        }
        detail={
          language === 'ru'
            ? 'Проверяйте готовый ответ или передайте документы специалисту.'
            : 'Check a response or pass your documents to a specialist.'
        }
        back
      />

      <div className="grid gap-3">
        <Link
          href="/visa/check"
          className="action-panel tone-blue"
          data-testid="card-visa-check"
        >
          <span className="service-icon">
            <FileCheck2 size={22} />
          </span>

          <span className="flex-1">
            <strong>Проверить ответ визы</strong>
            <small>Открыть официальный портал MFA Uzbekistan</small>
          </span>

          <ExternalLink size={17} />
        </Link>

        <Link
          href="/visa/apply"
          className="action-panel tone-pink"
          data-testid="card-visa-apply"
        >
          <span className="service-icon">
            <Upload size={22} />
          </span>

          <span className="flex-1">
            <strong>Подать документы</strong>
            <small>Barcode или номер заявки и номер телефона</small>
          </span>

          <ChevronRight size={17} />
        </Link>
      </div>

      <div className="info-strip mt-5">
        <div className="info-icon">
          <LockKeyhole size={18} />
        </div>

        <div>
          <strong>Приватно и прозрачно</strong>
          <p>
            Ваши данные остаются на устройстве до подключения серверной
            отправки.
          </p>
        </div>
      </div>

      {location !== '/visa' && (
        <button
          type="button"
          onClick={() => setLocation('/visa')}
          className="back-link mt-5"
          data-testid="button-visa-back"
        >
          <ArrowLeft size={16} />
          Назад к визовым услугам
        </button>
      )}
    </div>
  );
}

function VisaCheck() {
  return (
    <div>
      <SectionHeading
        eyebrow="VISA / CHECK"
        title="Проверка ответа"
        detail="Официальная страница разрешений МВД Узбекистана."
        back
      />

      <div className="form-card text-center">
        <div className="large-icon">
          <ExternalLink size={25} />
        </div>

        <h2 className="section-title mt-4">
          Открыть официальный портал
        </h2>

        <p className="page-detail">
          Omad Tour не запрашивает пароль или код подтверждения. Введите
          данные только на сайте MFA.
        </p>

        <a
          href={DESTINATIONS.visa}
          target="_blank"
          rel="noreferrer"
          className="primary-button mt-6 justify-center"
          data-testid="link-visa-official"
        >
          Перейти на visa.mfa.uz
          <ExternalLink size={16} />
        </a>
      </div>
    </div>
  );
}

function VisaApply() {
  const [barcode, setBarcode] = useState('');
  const [manual, setManual] = useState('');
  const [phone, setPhone] = useState('');
  const [imageName, setImageName] = useState('');

  const [requests, setRequests] = useLocalStorage<RequestItem[]>(
    'omad-requests',
    [],
  );

  const [sent, setSent] = useState(false);

  const submit = () => {
    setRequests([
      {
        id: `visa-${Date.now()}`,
        type: 'Visa application',
        title: 'Подача визовых документов',
        status: 'New',
        detail: `Номер: ${barcode || manual}. Телефон: ${phone}. Файл: ${
          imageName || 'не прикреплён'
        }`,
        created: new Date().toISOString(),
      },
      ...requests,
    ]);

    setSent(true);
  };

  return (
    <div>
      <SectionHeading
        eyebrow="VISA / APPLY"
        title="Передать документы"
        detail="Загрузите фото анкеты, укажите barcode или номер и оставьте телефон."
        back
      />

      {sent ? (
        <div className="form-card text-center rise-in">
          <div className="success-mark">
            <Check size={26} />
          </div>

          <h2 className="section-title mt-4">
            Заявка принята локально
          </h2>

          <p className="page-detail">
            ID заявки создан. Синхронизация с оператором появится после
            подключения защищённого сервера.
          </p>

          <Link
            href="/requests"
            className="primary-button mt-6 justify-center"
            data-testid="link-visa-requests"
          >
            Открыть статус заявки
            <ChevronRight size={16} />
          </Link>
        </div>
      ) : (
        <div className="form-card space-y-5">
          <label className="upload-zone">
            <Upload size={21} />

            <span>
              <strong>{imageName || 'Загрузить фото анкеты'}</strong>
              <small>JPG, PNG — только изображение бланка</small>
            </span>

            <input
              type="file"
              accept="image/*"
              onChange={(e) =>
                setImageName(e.target.files?.[0]?.name ?? '')
              }
              data-testid="input-visa-image"
            />
          </label>

          <div>
            <label className="field-label">Barcode рақами</label>

            <div className="input-wrap">
              <BarChart3 size={17} />

              <input
                value={barcode}
                onChange={(e) => setBarcode(e.target.value)}
                placeholder="Сканировать или ввести barcode"
                data-testid="input-visa-barcode"
              />
            </div>

            <p className="field-hint">
              Камера/сканерга рухсат берилса barcode автоматик ўқилади; ҳозир
              қўлда ҳам киритиш мумкин.
            </p>
          </div>

          <div className="or-divider">
            <span>или номер вручную</span>
          </div>

          <div>
            <label className="field-label">Номер заявки</label>

            <div className="input-wrap">
              <FileText size={17} />

              <input
                value={manual}
                onChange={(e) => setManual(e.target.value)}
                placeholder="Номер разрешения"
                data-testid="input-visa-manual"
              />
            </div>
          </div>

          <div>
            <label className="field-label">Номер телефона</label>

            <div className="input-wrap">
              <Phone size={17} />

              <input
                value={phone}
                onChange={(e) => setPhone(e.target.value)}
                placeholder="+7 900 000 00 00"
                data-testid="input-visa-phone"
              />
            </div>
          </div>

          <button
            type="button"
            onClick={submit}
            disabled={!(barcode || manual) || !phone}
            className="primary-button w-full justify-center disabled:opacity-40"
            data-testid="button-submit-visa"
          >
            Сохранить заявку
            <ArrowRight size={16} />
          </button>
        </div>
      )}
    </div>
  );
}

function Requests() {
  const [requests] = useLocalStorage<RequestItem[]>(
    'omad-requests',
    [],
  );

  return (
    <div>
      <SectionHeading
        eyebrow="YOUR DESK"
        title="Мои заявки"
        detail="История запросов на этом устройстве."
        back
      />

      {requests.length === 0 ? (
        <div className="empty-state">
          <div className="large-icon">
            <ClipboardList size={25} />
          </div>

          <h2 className="section-title mt-4">Заявок пока нет</h2>

          <p className="page-detail">
            Начните с авиабилета или визовой услуги — здесь появится статус.
          </p>

          <Link
            href="/tickets"
            className="primary-button mt-6 justify-center"
            data-testid="link-empty-tickets"
          >
            Создать запрос
            <Plus size={16} />
          </Link>
        </div>
      ) : (
        <div className="space-y-3">
          {requests.map((item) => (
            <div
              className="request-card rise-in"
              key={item.id}
              data-testid={`card-request-${item.id}`}
            >
              <div className="flex items-start gap-3">
                <div className="request-icon">
                  {item.type === 'Air ticket' ? (
                    <Ticket size={18} />
                  ) : (
                    <FileCheck2 size={18} />
                  )}
                </div>

                <div className="min-w-0 flex-1">
                  <div className="flex flex-wrap items-center justify-between gap-2">
                    <strong>{item.title}</strong>

                    <span
                      className={`status-pill status-${item.status
                        .replace(' ', '-')
                        .toLowerCase()}`}
                      data-testid={`status-request-${item.id}`}
                    >
                      {item.status}
                    </span>
                  </div>

                  <p className="mt-1 text-xs text-muted-foreground">
                    {item.type} ·{' '}
                    {new Date(item.created).toLocaleDateString()}
                  </p>

                  <p className="mt-3 text-sm leading-5 text-muted-foreground">
                    {item.detail}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

function Help() {
  const [text, setText] = useState('');
  const [file, setFile] = useState('');
  const [sent, setSent] = useState(false);

  return (
    <div>
      <SectionHeading
        eyebrow="DIRECT LINE"
        title="Чем помочь?"
        detail="Опишите вопрос — подготовим понятный ответ."
        back
      />

      {sent ? (
        <div className="form-card text-center">
          <div className="success-mark">
            <Check size={26} />
          </div>

          <h2 className="section-title mt-4">
            Сообщение сохранено
          </h2>

          <p className="page-detail">
            Синхронизация с оператором подключится следующим шагом.
          </p>

          <button
            type="button"
            className="secondary-button mt-6 justify-center"
            onClick={() => {
              setSent(false);
              setText('');
              setFile('');
            }}
            data-testid="button-help-new"
          >
            Новое сообщение
          </button>
        </div>
      ) : (
        <div className="form-card space-y-5">
          <div>
            <label className="field-label">Ваш вопрос</label>

            <textarea
              value={text}
              onChange={(e) => setText(e.target.value)}
              rows={5}
              placeholder="Например: нужна виза в Узбекистан..."
              className="textarea"
              data-testid="textarea-help"
            />
          </div>

          <label className="attachment-button">
            <Paperclip size={17} />
            {file || 'Прикрепить изображение'}

            <input
              type="file"
              accept="image/*"
              onChange={(e) =>
                setFile(e.target.files?.[0]?.name ?? '')
              }
              data-testid="input-help-image"
            />
          </label>

          <button
            type="button"
            disabled={!text.trim()}
            onClick={() => setSent(true)}
            className="primary-button w-full justify-center disabled:opacity-40"
            data-testid="button-help-submit"
          >
            <Send size={16} />
            Отправить вопрос
          </button>
        </div>
      )}
    </div>
  );
}

function Specialist() {
  return (
    <div>
      <SectionHeading
        eyebrow="OMAD TOUR TEAM"
        title="Связаться со специалистом"

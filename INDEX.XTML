    <button
      type="button"
      onClick={onTap}
      className={`brand-mark brand-${size}`}
      data-testid="button-brand-logo"
      aria-label="Omad Tour logo"
    >
      <img src={logoPath} alt="Omad Tour" />
    </button>
  );
}

function Shell({
  children,
  language,
  setLanguage,
  dark,
  setDark,
  taps,
  setTaps,
}: {
  children: ReactNode;
  language: Language;
  setLanguage: (v: Language) => void;
  dark: boolean;
  setDark: (v: boolean) => void;
  taps: number;
  setTaps: (v: number) => void;
}) {
  const [location, setLocation] = useLocation();
  const isHome = location === '/';
  const [menuOpen, setMenuOpen] = useState(false);

  const nav = [
    { href: '/', key: 'home', icon: Plane },
    { href: '/tickets', key: 'tickets', icon: Ticket },
    { href: '/visa', key: 'visa', icon: FileCheck2 },
    { href: '/requests', key: 'requests', icon: ClipboardList },
  ];

  return (
    <div className="grain min-h-[100dvh] shell-bg">
      <header className="sticky top-0 z-10 border-b bg-background/90 backdrop-blur-md">
        <div className="mx-auto flex h-16 max-w-3xl items-center justify-between px-4">
          <div className="flex items-center gap-3">
            {!isHome && (
              <button
                type="button"
                onClick={() =>
                  setLocation(
                    location.startsWith('/visa/') ? '/visa' : '/',
                  )
                }
                className="icon-button"
                data-testid="button-header-home"
                aria-label="Orqaga"
              >
                <ArrowLeft size={19} />
              </button>
            )}

            <Logo
              size="sm"
              onTap={() => {
                const next = taps + 1;
                setTaps(next);

                if (next >= 5) {
                  setTaps(0);
                  setLocation('/admin');
                }
              }}
            />

            <div>
              <p className="font-display text-sm font-bold leading-none">
                Omad Tour
              </p>
              <p className="mt-1 text-[10px] font-semibold uppercase tracking-[.18em] text-muted-foreground">
                travel desk · SPB
              </p>
            </div>
          </div>

          <div className="flex items-center gap-1.5">
            <button
              type="button"
              className="icon-button"
              onClick={() => setDark(!dark)}
              data-testid="button-toggle-theme"
              aria-label="Toggle theme"
            >
              {dark ? <Sun size={18} /> : <Moon size={18} />}
            </button>

            <button
              type="button"
              className="icon-button md:hidden"
              onClick={() => setMenuOpen(!menuOpen)}
              data-testid="button-open-menu"
            >
              <Menu size={19} />
            </button>

            <select
              value={language}
              onChange={(e) => setLanguage(e.target.value as Language)}
              className="language-select hidden md:block"
              aria-label={tr(language, 'language')}
              data-testid="select-language"
            >
              <option value="uz">UZ</option>
              <option value="ru">RU</option>
              <option value="tk">TK</option>
              <option value="en">EN</option>
            </select>
          </div>
        </div>

        {menuOpen && (
          <div className="border-t bg-card px-4 py-3 md:hidden">
            <div className="grid grid-cols-2 gap-2">
              {nav.map(({ href, key, icon: Icon }) => (
                <Link
                  key={href}
                  href={href}
                  onClick={() => setMenuOpen(false)}
                  className="menu-link"
                  data-testid={`link-menu-${key}`}
                >
                  <Icon size={16} />
                  {tr(language, key)}
                </Link>
              ))}
            </div>

            <select
              value={language}
              onChange={(e) => setLanguage(e.target.value as Language)}
              className="language-select mt-3 w-full"
              data-testid="select-language-mobile"
            >
              <option value="uz">O‘zbekcha</option>
              <option value="ru">Русский</option>
              <option value="tk">Türkmençe</option>
              <option value="en">English</option>
            </select>
          </div>
        )}
      </header>

      <main
        className={`mx-auto w-full max-w-3xl px-4 ${
          isHome ? 'pb-28' : 'pb-8'
        } pt-6`}
      >
        {children}
      </main>

      {isHome && (
        <nav
          className="bottom-nav fixed bottom-0 left-0 right-0 z-10 mx-auto max-w-3xl border-t bg-card/95 px-2 py-2 backdrop-blur-md"
          data-testid="nav-bottom"
        >
          {nav.map(({ href, key, icon: Icon }) => (
            <Link
              href={href}
              key={href}
              className={`bottom-item ${
                location === href ? 'active' : ''
              }`}
              data-testid={`link-bottom-${key}`}
            >
              <Icon size={18} />
              <span>{tr(language, key)}</span>
            </Link>
          ))}
        </nav>
      )}
    </div>
  );
}

function SectionHeading({
  eyebrow,
  title,
  detail,
  back,
}: {
  eyebrow?: string;
  title: string;
  detail?: string;
  back?: boolean;
}) {
  return (
    <div className="mb-6 rise-in">
      {eyebrow && <p className="eyebrow">{eyebrow}</p>}
      <h1 className="page-title">{title}</h1>
      {detail && <p className="page-detail">{detail}</p>}
    </div>
  );
}


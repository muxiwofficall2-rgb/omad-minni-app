}

function Groups() {
  const groups = [
    {
      name: 'Oylik biletlar narxi va qulay narx',
      detail: 'Aviachiptalar va maxsus takliflar',
      href: 'https://t.me/+4RhCSj7qgnxjNWNi',
    },
    {
      name: 'UZ Res Sankt-Peterburgdagi Bosh konsulxonasi',

## 2. `artifacts/omad-tour-mini-app/src/index.css`

```css
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
@import 'tailwindcss';
@import 'tw-animate-css';

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));
  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-card-border: hsl(var(--card-border));
  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));
  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));
  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));
  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));
  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));
  --font-sans: var(--app-font-sans);
  --font-display: var(--app-font-display);
  --font-mono: var(--app-font-mono);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

:root {
  --background: 34 48% 96%;
  --foreground: 290 31% 17%;
  --border: 30 27% 86%;
  --input: 30 27% 86%;
  --ring: 316 63% 42%;
  --card: 36 60% 99%;
  --card-foreground: 290 31% 17%;
  --card-border: 30 27% 86%;
  --primary: 316 63% 42%;
  --primary-foreground: 36 60% 99%;
  --secondary: 196 38% 93%;
  --secondary-foreground: 201 38% 25%;
  --muted: 31 31% 91%;
  --muted-foreground: 290 12% 47%;
  --accent: 33 86% 61%;
  --accent-foreground: 290 31% 17%;
  --destructive: 2 66% 48%;
  --destructive-foreground: 36 60% 99%;
  --sidebar: 289 29% 22%;
  --sidebar-foreground: 36 60% 99%;
  --sidebar-border: 289 23% 31%;
  --app-font-sans: 'DM Sans', sans-serif;
  --app-font-display: 'Space Grotesk', sans-serif;
  --app-font-mono: 'Space Grotesk', monospace;
  --radius: 1rem;
  --shadow-soft: 0 14px 40px rgba(87, 34, 71, 0.1);
}

.dark {
  --background: 287 26% 12%;
  --foreground: 34 39% 94%;
  --border: 289 18% 28%;
  --input: 289 18% 28%;
  --ring: 316 68% 63%;
  --card: 288 24% 17%;
  --card-foreground: 34 39% 94%;
  --card-border: 289 18% 28%;
  --primary: 316 68% 63%;
  --primary-foreground: 287 26% 12%;
  --secondary: 196 28% 24%;
  --secondary-foreground: 196 45% 88%;
  --muted: 289 21% 23%;
  --muted-foreground: 31 19% 70%;
  --accent: 34 85% 62%;
  --accent-foreground: 287 26% 12%;
  --destructive: 2 73% 62%;
  --destructive-foreground: 287 26% 12%;
  --sidebar: 288 29% 9%;
  --sidebar-foreground: 34 39% 94%;
  --sidebar-border: 289 19% 20%;
  --shadow-soft: 0 14px 40px rgba(0, 0, 0, 0.24);
}

@layer base {
  * {
    @apply border-border;
  }

  html {
    background: hsl(var(--background));
  }

  body {
    @apply font-sans antialiased bg-background text-foreground;
    margin: 0;
  }

  button,
  a,
  input,
  select,
  textarea {
    -webkit-tap-highlight-color: transparent;
  }

  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid hsl(var(--accent) / 0.65);
    outline-offset: 3px;
  }
}

@layer utilities {
  .font-display {
    font-family: var(--app-font-display);
  }

  .shell-bg {
    background:
      radial-gradient(
        circle at 90% 0%,
        hsl(var(--accent) / 0.16),
        transparent 28rem
      ),
      hsl(var(--background));
  }

  .grain::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.035;
    z-index: 20;
    background-image: radial-gradient(
      hsl(var(--foreground) / 0.45) 0.45px,
      transparent 0.45px
    );
    background-size: 5px 5px;
  }

  .rise-in {
    animation: rise-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .delay-1 {
    animation-delay: 0.06s;
  }

  .delay-2 {
    animation-delay: 0.12s;
  }

  .delay-3 {
    animation-delay: 0.18s;
  }
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  overflow: hidden;
  flex: none;
  background: hsl(var(--card));
  border: 1px solid hsl(var(--border));
  padding: 2px;
  transition: transform 0.2s ease;
}

.brand-mark:hover {
  transform: rotate(-4deg) scale(1.04);
}

.brand-mark img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 999px;
}

.brand-sm {
  width: 34px;
  height: 34px;
}

.brand-md {
  width: 56px;
  height: 56px;
}

.brand-lg {
  width: 76px;
  height: 76px;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  color: hsl(var(--muted-foreground));
  transition:
    background 0.2s,
    color 0.2s,
    transform 0.2s;
}

.icon-button:hover {
  background: hsl(var(--muted));
  color: hsl(var(--foreground));
  transform: translateY(-1px);
}

.language-select {
  border: 1px solid hsl(var(--border));
  background: hsl(var(--card));
  color: hsl(var(--foreground));
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  padding: 7px 8px;
  border-radius: 9px;
}

.bottom-nav {
  box-shadow: 0 -12px 30px hsl(var(--foreground) / 0.06);
}

.bottom-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 6px 3px;
  color: hsl(var(--muted-foreground));
  font-size: 10px;
  font-weight: 600;
  text-decoration: none;
  transition:
    color 0.2s,
    transform 0.2s;
}

.bottom-item.active {
  color: hsl(var(--primary));
}

.bottom-item:hover {
  transform: translateY(-1px);
  color: hsl(var(--primary));
}

.menu-link {
  display: flex;
  gap: 8px;
  align-items: center;
  border: 1px solid hsl(var(--border));
  border-radius: 10px;
  padding: 10px;
  font-size: 12px;
  font-weight: 600;
  color: hsl(var(--foreground));
  text-decoration: none;
}

.eyebrow {
  color: hsl(var(--muted-foreground));
  font-family: var(--app-font-display);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.page-title {
  margin-top: 7px;
  font-family: var(--app-font-display);
  font-size: clamp(29px, 8vw, 43px);
  line-height: 1.05;
  letter-spacing: -0.045em;
  font-weight: 700;
}

.page-detail {
  margin-top: 10px;
  max-width: 470px;
  color: hsl(var(--muted-foreground));
  font-size: 14px;
  line-height: 1.55;
}

.section-title {
  font-family: var(--app-font-display);
  font-size: 22px;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -0.03em;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 4px 0 13px;
  color: hsl(var(--muted-foreground));
  font-size: 12px;
  font-weight: 600;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: hsl(var(--primary));
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
}

.hero-panel {
  position: relative;
  overflow: hidden;
  min-height: 286px;
  padding: 28px 24px;
  border-radius: 24px;
  color: #fff;
  background: linear-gradient(
    132deg,
    hsl(289 30% 22%),
    hsl(316 58% 34%)
  );
  box-shadow: var(--shadow-soft);
}

.hero-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    115deg,
    transparent 30%,
    hsl(var(--accent) / 0.15)
  );
  pointer-events: none;
}

.hero-title {
  margin-top: 14px;
  font-family: var(--app-font-display);
  font-size: clamp(38px, 12vw, 62px);
  line-height: 0.96;
  letter-spacing: -0.065em;
  font-weight: 700;
}

.hero-title span {
  color: hsl(var(--accent));
}

.primary-button {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  border-radius: 11px;
  padding: 12px 16px;
  background: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  transition:
    transform 0.2s,
    filter 0.2s;
}

.primary-button:hover {
  filter: brightness(1.08);
  transform: translateY(-2px);
}

.primary-button:active {
  transform: translateY(0);
}

.secondary-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid hsl(var(--border));
  border-radius: 11px;
  padding: 11px 15px;
  background: hsl(var(--card));
  color: hsl(var(--foreground));
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.hero-orbit {
  position: absolute;
  border: 1px solid hsl(var(--accent) / 0.31);
  border-radius: 50%;
  transform: rotate(-30deg);
}

.orbit-one {
  width: 310px;
  height: 130px;
  right: -80px;
  bottom: 21px;
}

.orbit-two {
  width: 260px;
  height: 90px;
  right: -48px;
  bottom: 53px;
  border-color: hsl(196 55% 76% / 0.32);
}

.hero-plane {
  position: absolute;
  right: 26px;
  bottom: 62px;
  color: hsl(var(--accent));
  opacity: 0.9;
  transform: rotate(10deg);
}

.service-card,
.action-panel,
.group-card,
.contact-action {
  display: flex;
  align-items: center;
  gap: 13px;
  border: 1px solid hsl(var(--border));
  border-radius: 16px;
  padding: 15px;
  color: hsl(var(--foreground));
  text-decoration: none;
  box-shadow: 0 2px 0 hsl(var(--foreground) / 0.025);
  transition:
    transform 0.2s,
    border-color 0.2s,
    background 0.2s;
}

.service-card:hover,
.action-panel:hover,
.group-card:hover,
.contact-action:hover {
  transform: translateX(3px);
  border-color: hsl(var(--primary) / 0.45);
  background: hsl(var(--card));
}

.tone-pink {
  background: hsl(var(--primary) / 0.07);
}

.tone-blue {
  background: hsl(196 55% 78% / 0.16);
}

.tone-sand {
  background: hsl(var(--accent) / 0.13);
}

.service-icon,
.request-icon,
.info-icon,
.large-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  flex: none;
  border-radius: 12px;
  background: hsl(var(--card));
  color: hsl(var(--primary));
}

.service-card strong,
.action-panel strong,
.group-card strong,
.contact-action strong {
  display: block;
  font-size: 14px;
}

.service-card small,
.action-panel small,
.group-card small,
.contact-action small {
  display: block;
  margin-top: 4px;
  color: hsl(var(--muted-foreground));
  font-size: 12px;
  line-height: 1.35;
}

.info-strip {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  border: 1px solid hsl(var(--accent) / 0.23);
  border-radius: 14px;
  padding: 13px;
  background: hsl(var(--accent) / 0.09);
}

.info-strip strong {
  font-size: 12px;
}

.info-strip p {
  margin-top: 3px;
  color: hsl(var(--muted-foreground));
  font-size: 11px;
  line-height: 1.45;
}

.info-icon {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: hsl(var(--accent) / 0.23);
  color: hsl(var(--accent-foreground));
}

.mini-card {
  display: flex;
  align-items: center;
  gap: 9px;
  border: 1px solid hsl(var(--border));
  border-radius: 13px;
  padding: 13px;
  color: hsl(var(--foreground));
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
  transition: transform 0.2s;
}

.mini-card:hover {
  transform: translateY(-2px);
  color: hsl(var(--primary));
}

.stepper {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: -7px 0 17px;
  color: hsl(var(--muted-foreground));
  font-family: var(--app-font-display);
  font-size: 11px;
  font-weight: 700;
}

.stepper span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 1px solid hsl(var(--border));
}

.stepper span.active {
  border-color: hsl(var(--primary));
  background: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
}

.stepper i {
  height: 1px;
  flex: 1;
  background: hsl(var(--border));
}

.form-card,
.empty-state {
  border: 1px solid hsl(var(--border));
  border-radius: 18px;
  padding: 18px;
  background: hsl(var(--card));
  box-shadow: var(--shadow-soft);
}

.upload-zone {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px dashed hsl(var(--primary) / 0.42);
  border-radius: 15px;
  padding: 15px;
  color: hsl(var(--primary));
  background: hsl(var(--primary) / 0.045);
  cursor: pointer;
  transition:
    background 0.2s,
    border-color 0.2s,
    transform 0.2s;
}

.upload-zone:hover {
  background: hsl(var(--primary) / 0.09);
  border-color: hsl(var(--primary) / 0.7);
  transform: translateY(-1px);
}

.upload-zone input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.upload-zone span {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}

.upload-zone strong {
  overflow: hidden;
  color: hsl(var(--foreground));
  font-size: 13px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-zone small,
.field-hint {
  color: hsl(var(--muted-foreground));
  font-size: 11px;
  line-height: 1.45;
}

.field-hint {
  margin-top: 6px;
}

.field-label {
  display: block;
  margin-bottom: 7px;
  color: hsl(var(--muted-foreground));
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid hsl(var(--input));
  border-radius: 11px;
  padding: 0 12px;
  background: hsl(var(--background));
  color: hsl(var(--muted-foreground));
  transition:
    border-color 0.2s,
    box-shadow 0.2s;
}

.input-wrap:focus-within {
  border-color: hsl(var(--primary));
  box-shadow: 0 0 0 3px hsl(var(--primary) / 0.11);
}

.input-wrap input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  padding: 12px 0;
  color: hsl(var(--foreground));
  font-size: 14px;
}

.choice-question,
.counter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.choice-question strong {
  display: block;
  font-size: 14px;
}

.choice-question small {
  display: block;
  margin-top: 4px;
  color: hsl(var(--muted-foreground));
  font-size: 11px;
}

.toggle {
  width: 44px;
  height: 25px;
  border-radius: 99px;
  background: hsl(var(--muted));
  padding: 3px;
  transition: background 0.2s;
}

.toggle span {
  display: block;
  width: 19px;
  height: 19px;
  border-radius: 50%;
  background: hsl(var(--card));
  transition: transform 0.2s;
}

.toggle.on {
  background: hsl(var(--primary));
}

.toggle.on span {
  transform: translateX(19px);
}

.counter {
  display: flex;
  align-items: center;
  gap: 14px;
}

.counter button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: 1px solid hsl(var(--border));
  border-radius: 8px;
  color: hsl(var(--primary));
}

.counter b {
  min-width: 12px;
  text-align: center;
  font-family: var(--app-font-display);
}

.request-preview {
  border-radius: 12px;
  padding: 13px;
  background: hsl(var(--muted) / 0.6);
}

.preview-label {
  display: flex;
  align-items: center;
  gap: 6px;
  color: hsl(var(--primary));
  font-size: 11px;
  font-weight: 700;
}

.request-preview p {
  margin-top: 8px;
  color: hsl(var(--foreground));
  font-size: 13px;
  line-height: 1.5;
}

.success-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54px;
  height: 54px;
  margin: auto;
  border-radius: 50%;
  background: hsl(145 50% 43% / 0.15);
  color: hsl(145 50% 35%);
}

.large-icon {
  width: 56px;
  height: 56px;
  margin: auto;
  border-radius: 16px;
  background: hsl(var(--primary) / 0.1);
}

.or-divider {
  display: flex;
  align-items: center;
  gap: 10px;
  color: hsl(var(--muted-foreground));
  font-size: 11px;
}

.or-divider::before,
.or-divider::after {
  content: '';
  height: 1px;
  flex: 1;
  background: hsl(var(--border));
}

.textarea {
  width: 100%;
  resize: vertical;
  min-height: 120px;
  border: 1px solid hsl(var(--input));
  border-radius: 11px;
  padding: 12px;
  outline: 0;
  background: hsl(var(--background));
  color: hsl(var(--foreground));
  font: inherit;
  font-size: 14px;
}

.textarea:focus {
  border-color: hsl(var(--primary));
  box-shadow: 0 0 0 3px hsl(var(--primary) / 0.11);
}

.attachment-button {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px dashed hsl(var(--border));
  border-radius: 11px;
  padding: 12px;
  color: hsl(var(--muted-foreground));
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.attachment-button input {
  display: none;
}

.request-card {
  border: 1px solid hsl(var(--border));
  border-radius: 15px;
  padding: 15px;
  background: hsl(var(--card));
}

.request-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: hsl(var(--primary) / 0.1);
}

.status-pill {
  display: inline-flex;
  border-radius: 99px;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 700;
}

.status-new {
  background: hsl(var(--accent) / 0.2);
  color: hsl(30 54% 34%);
}

.status-in-review {
  background: hsl(196 55% 78% / 0.35);
  color: hsl(201 38% 28%);
}

.status-completed {
  background: hsl(145 50% 43% / 0.16);
  color: hsl(145 50% 30%);
}

.contact-card {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 16px;
  border: 1px solid hsl(var(--border));
  border-radius: 16px;
  background: hsl(var(--card));
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
}

.contact-card strong {
  font-size: 15px;
}

.contact-card p {
  color: hsl(var(--muted-foreground));
  font-size: 12px;
}

.online-dot {
  width: 8px;
  height: 8px;
  margin-left: auto;
  border-radius: 50%;
  background: #53a86a;
  box-shadow: 0 0 0 4px hsl(145 50% 43% / 0.12);
}

.contact-action {
  padding: 16px;
}

.contact-action.telegram {
  border-color: hsl(196 50% 60% / 0.4);
  background: hsl(196 55% 78% / 0.13);
}

.contact-action span {
  flex: 1;
}

.small-contact {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 1px solid hsl(var(--border));
  border-radius: 12px;
  padding: 12px;
  color: hsl(var(--foreground));
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
}

.group-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 39px;
  height: 39px;
  border-radius: 12px;
  background: hsl(var(--primary) / 0.1);
  color: hsl(var(--primary));
}

.map-card {
  overflow: hidden;
  border: 1px solid hsl(var(--border));
  border-radius: 18px;
  background: hsl(var(--card));
  box-shadow: var(--shadow-soft);
}

.map-pattern {
  display: flex;
  height: 170px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: hsl(var(--primary));
  background-color: hsl(196 32% 86%);
  background-image:
    linear-gradient(
      30deg,
      transparent 47%,
      hsl(var(--card) / 0.65) 48%,
      hsl(var(--card) / 0.65) 50%,
      transparent 51%
    ),
    linear-gradient(
      120deg,
      transparent 46%,
      hsl(var(--card) / 0.55) 47%,
      hsl(var(--card) / 0.55) 49%,
      transparent 50%
    );
  background-size: 48px 48px;
}

.map-pattern span {
  border-radius: 99px;
  padding: 5px 9px;
  background: hsl(var(--card) / 0.85);
  font-family: var(--app-font-display);
  font-size: 11px;
  font-weight: 700;
}

.address-copy {
  padding: 16px;
}

.address-copy p {
  color: hsl(var(--muted-foreground));
  font-size: 13px;
  line-height: 1.45;
}

.admin-stat {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 18px;
  border-radius: 16px;
  background: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
}

.admin-stat span {
  display: flex;
  flex-direction: column;
}

.admin-stat small {
  opacity: 0.75;
  font-size: 11px;
}

.admin-stat strong {
  font-family: var(--app-font-display);
  font-size: 28px;
  line-height: 1.1;
}

.notice-text {
  border-radius: 10px;
  padding: 10px;
  color: hsl(var(--muted-foreground));
  background: hsl(var(--muted));
  font-size: 11px;
  line-height: 1.45;
}

.empty-state {
  display: flex;
  min-height: 260px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: hsl(var(--muted-foreground));
}

.empty-state .section-title {
  color: hsl(var(--foreground));
}

.bottom-nav {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  gap: 4px;
  padding-bottom: calc(8px + env(safe-area-inset-bottom));
}

.bottom-item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  border-radius: 10px;
  padding: 7px 3px 5px;
  color: hsl(var(--muted-foreground));
  font-size: 10px;
  font-weight: 700;
  text-decoration: none;
  transition:
    color 0.2s,
    background 0.2s;
}

.bottom-item:hover,
.bottom-item.active {
  color: hsl(var(--primary));
  background: hsl(var(--primary) / 0.08);
}

@media (min-width: 640px) {
  .bottom-nav {
    border-radius: 18px 18px 0 0;
  }

  .hero-panel {
    padding: 36px;
  }

  .form-card {
    padding: 24px;
  }
}
```


function Address() {
  return (
    <div>
      <SectionHeading
        eyebrow="FIND US"
        title="Мы рядом с консульством"
        detail="Зайдите в офис — поможем разобраться на месте."
        back
      />

      <div className="map-card">
        <div className="map-pattern">
          <Map size={48} />
          <span>Санкт-Петербург</span>
        </div>

        <div className="address-copy">
          <div className="flex items-start gap-3">
            <div className="request-icon">
              <Building2 size={18} />
            </div>

            <div>
              <strong>Omad Tour</strong>

              <p>
                4-Красноармейская улица, дом 3, офис «Омад Тур»
              </p>

              <p className="mt-2 text-sm text-muted-foreground">
                Через арку дома, домофон 22В
              </p>

              <p className="mt-2 text-xs text-muted-foreground">
                Точный маршрут откроется в Яндекс Картах
              </p>
            </div>
          </div>

          <a
            href={DESTINATIONS.maps}
            target="_blank"
            rel="noreferrer"
            className="primary-button mt-5 justify-center"
            data-testid="link-yandex-maps"
          >

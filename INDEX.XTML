          <p>
            Напишите нам, чтобы уточнить часы работы и свободного
            специалиста.
          </p>
        </div>
      </div>
    </div>
  );
}

function Admin() {
  const [password, setPassword] = useState('');
  const [unlocked, setUnlocked] = useState(false);

  const [requests] = useLocalStorage<RequestItem[]>(
    'omad-requests',
    [],
  );

  const configured = Boolean(import.meta.env.VITE_OMAD_ADMIN_PASSWORD);

  if (!unlocked) {
    return (
      <div>
        <SectionHeading
          eyebrow="PRIVATE AREA"
          title="Панель администратора"
          detail="Служебный доступ Omad Tour."
          back
        />

        <div className="form-card space-y-5">
          <div className="large-icon">
            <LockKeyhole size={24} />
          </div>

          <div>
            <label className="field-label">
              Пароль администратора
            </label>

            <div className="input-wrap">
              <LockKeyhole size={17} />

              <input
                type="password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="Введите пароль"
                data-testid="input-admin-password"
              />
            </div>
          </div>

          {!configured && (
            <p className="notice-text">
              Пароль подключается через защищённую настройку окружения. В
              этом первом локальном билде серверный доступ ещё не активирован.
            </p>
          )}

          <button
            type="button"
            disabled={!configured}
            onClick={() =>
              setUnlocked(
                password === import.meta.env.VITE_OMAD_ADMIN_PASSWORD,
              )
            }
            className="primary-button w-full justify-center disabled:opacity-40"
            data-testid="button-admin-login"
          >
            <LockKeyhole size={16} />
            Войти
          </button>
        </div>
      </div>
    );
  }

  return (
    <div>
      <SectionHeading
        eyebrow="PRIVATE AREA"
        title="Обзор заявок"
        detail="Локальный просмотр. Синхронизация с ботом будет подключена позже."
        back
      />

      <div className="admin-stat">
        <BarChart3 size={20} />

        <span>
          <small>Всего локальных заявок</small>
          <strong>{requests.length}</strong>
        </span>
      </div>

      <div className="mt-4 space-y-3">
        {requests.length ? (
          requests.map((request) => (
            <div className="request-card" key={request.id}>
              <strong>{request.title}</strong>
              <p className="text-xs text-muted-foreground">
                {request.status} · {request.type}
              </p>
            </div>
          ))
        ) : (
          <div className="empty-state">
            <ClipboardList size={26} />
            <p>Пока нет локальных заявок.</p>
          </div>
        )}
      </div>
    </div>
  );
}

function NotFound() {
  const [, setLocation] = useLocation();

  return (
    <div className="empty-state">
      <X size={28} />

      <h1 className="section-title mt-4">
        Страница не найдена
      </h1>

      <button
        type="button"
        className="primary-button mt-5"
        onClick={() => setLocation('/')}
        data-testid="button-not-found-home"
      >
        На главную
      </button>
    </div>
  );
}

function RouterView({ language }: { language: Language }) {
  return (
    <Switch>
      <Route path="/" component={() => <Home language={language} />} />
      <Route
        path="/tickets"
        component={() => <Tickets language={language} />}
      />
      <Route
        path="/visa"
        component={() => <Visa language={language} />}
      />
      <Route path="/visa/check" component={VisaCheck} />
      <Route path="/visa/apply" component={VisaApply} />
      <Route path="/requests" component={Requests} />
      <Route path="/help" component={Help} />
      <Route path="/specialist" component={Specialist} />
      <Route path="/groups" component={Groups} />
      <Route path="/address" component={Address} />
      <Route path="/admin" component={Admin} />
      <Route component={NotFound} />
    </Switch>
  );
}

function App() {
  const [language, setLanguage] = useLocalStorage<Language>(
    'omad-language',
    'ru',
  );

  const [dark, setDark] = useLocalStorage<boolean>(
    'omad-theme',
    false,
  );

  const [taps, setTaps] = useState(0);

  useEffect(() => {
    document.documentElement.classList.toggle('dark', dark);
  }, [dark]);

  return (
    <QueryClientProvider client={queryClient}>
      <TooltipProvider>
        <WouterRouter
          base={import.meta.env.BASE_URL.replace(/\/$/, '')}
        >
          <Shell
            language={language}
            setLanguage={setLanguage}
            dark={dark}
            setDark={setDark}
            taps={taps}
            setTaps={setTaps}
          >
            <ErrorBoundary resetKey={location.pathname}>
              <RouterView language={language} />
            </ErrorBoundary>
          </Shell>
        </WouterRouter>

        <Toaster />
      </TooltipProvider>
    </QueryClientProvider>
  );
}

export default App;
```

